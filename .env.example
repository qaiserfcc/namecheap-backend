# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/ecommerce_db

# JWT Secret (Change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration (Frontend URL)
# Update this with your frontend application URL
FRONTEND_URL=http://localhost:3001

# Payment Configuration
# Set to 'false' in production to require real payment gateway integration
# Set to 'true' or leave unset for development/testing with simulation
ENABLE_PAYMENT_SIMULATION=true
